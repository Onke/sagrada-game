<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/sagrada_background" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim" />

    <!--
      One child per screen. Routing through a flipper means exactly one screen can ever be
      visible, which the previous hand-maintained hide-everything list could not guarantee.
    -->
    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/screenHome"
            layout="@layout/screen_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/screenConnect"
            layout="@layout/screen_connect"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/screenLobby"
            layout="@layout/screen_lobby"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/screenObjectives"
            layout="@layout/screen_objectives"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/screenWindows"
            layout="@layout/screen_windows"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/screenGame"
            layout="@layout/screen_game"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/screenRound"
            layout="@layout/screen_round"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/screenStandings"
            layout="@layout/screen_standings"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </ViewFlipper>
</FrameLayout>
